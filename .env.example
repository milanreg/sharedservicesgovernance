# Copy to .env and fill in. .env is git-ignored — never commit real tokens.
#
# Option A — reuse a credentials file you already have (for example the
# regnology-mcp .env). Nothing else is needed in this file.
# ENV_FILE=C:\code\regnology-mcp\.env
#
# Option B — set the values here.
#
# Jira Cloud. Create an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# The JIRA_CLOUD_BASE_URL / JIRA_CLOUD_EMAIL / JIRA_CLOUD_API_TOKEN triple is
# preferred when present, so a file that also holds Data Center values works.
JIRA_BASE_URL=https://regnology-cloud.atlassian.net
JIRA_EMAIL=you@regnology.com
JIRA_API_TOKEN=

# Confluence Data Center. Create a personal access token from your
# Confluence profile > Personal Access Tokens. Optional: leave the token
# blank and the sync will refresh Jira only.
# CONFLUENCE_URL / CONFLUENCE_PAT also work.
CONFLUENCE_BASE_URL=https://confluence.regnology.net
CONFLUENCE_TOKEN=
